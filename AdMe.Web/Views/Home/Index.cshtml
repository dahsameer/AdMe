                        <div class="col-md-10 col-sm-10">
                            <div class="form-group">
                                <img src="@Context.Session.GetString("Photo")" alt="" class="profile-photo-md" />
                                <textarea name="texts" id="postCreateBox" cols="40" rows="1" class="form-control" placeholder="Write what you wish"></textarea>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2">
                            <div class="tools">
                                <button id="postSubmitButton" class="btn btn-primary pull-right">Publish</button>
                            </div>
                        </div>
                    </div>
                </div><!-- Post Create Box End-->
