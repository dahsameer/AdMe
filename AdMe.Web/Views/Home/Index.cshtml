@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home Page";
}

<div class="page-contents">
    <div class="container">
        <div class="row">

            <!-- Newsfeed Common Side Bar Left
            ================================================= -->
            <div style="margin-top: 20px;" class="col-md-3 static">
                <div class="profile-card">
                    <img src="@Context.Session.GetString("Photo")" alt="user" class="profile-photo" />
                    <h5><a href="/user/@Context.Session.GetString("User")" class="text-white">@Context.Session.GetString("Fullname")</a></h5>
                    <a href="#" class="text-white"><i class="ion ion-android-person-add"></i> @Context.Session.GetString("User")</a>
                </div><!--profile card ends-->
                <ul class="nav-news-feed">
                    <li><i class="icon ion-ios-paper"></i><div><a href="/">My Newsfeed</a></div></li>
                    <li><i class="icon ion-ios-people"></i><div><a href="/user/@Context.Session.GetString("User")/followers">Followers</a></div></li>
                    <li><i class="icon ion-ios-people-outline"></i><div><a href="/user/@Context.Session.GetString("User")/following">Following</a></div></li>
                </ul><!--news-feed links ends-->
