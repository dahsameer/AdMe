@model AdMe.Model.User.UserProfile
@{
    ViewData["Title"] = "Followers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">

    <!-- Timeline
    ================================================= -->
    <div class="timeline">
        <div class="timeline-cover">

            <!--Timeline Menu for Large Screens-->
            <div class="timeline-nav-bar hidden-sm hidden-xs">
                <div class="row">
                    <div class="col-md-3">
                        <div class="profile-info">
                            <img src="@Model.Photo" alt="" class="img-responsive profile-photo" />
                            <h3>@Model.Fullname</h3>
                            <p class="text-muted">@Model.Username</p>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <ul class="list-inline profile-menu">
                            <li><a href="/user/@Model.Username">Timeline</a></li>
                            <li><a href="/user/@Model.Username/about">About</a></li>
                            <li><a href="/user/@Model.Username/followers" class="active">Followers</a></li>
                            <li><a href="/user/@Model.Username/following">Following</a></li>
                        </ul>
                        <ul class="follow-me list-inline">
                            <li><button id="followbutton" data-userid="@Model.Id" class="btn-primary"></button></li>
                        </ul>
                    </div>
                </div>
            </div><!--Timeline Menu for Large Screens End-->
            <!--Timeline Menu for Small Screens-->
            <div class="navbar-mobile hidden-lg hidden-md">
                <div class="profile-info">
                    <img src="@Model.Photo" alt="" class="img-responsive profile-photo" />
                    <h4>Sarah Cruiz</h4>
                    <p class="text-muted">@Model.Username</p>
                </div>
                <div class="mobile-menu">
                    <ul class="list-inline">
                        <li><a href="/user/@Model.Username">Timeline</a></li>
                        <li><a href="/user/@Model.Username/about">About</a></li>
                        <li><a href="/user/@Model.Username/followers" class="active">Followers</a></li>
                        <li><a href="/user/@Model.Username/following">Following</a></li>
                    </ul>
                    <button id="followbutton" data-userid="@Model.Id" class="btn-primary"></button>
                </div>
            </div><!--Timeline Menu for Small Screens End-->

        </div>
        <div id="page-contents">
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-7">

                    <!-- Friend List
                    ================================================= -->
                    <div class="friend-list">
                        <div class="row" id="friendList">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/FollowScript.js"></script>
    <script src="~/js/FollowersPage.js"></script>
}